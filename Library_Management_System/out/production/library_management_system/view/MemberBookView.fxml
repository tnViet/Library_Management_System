<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MemberBookViewController" prefHeight="600.0" prefWidth="900.0">

    <!-- Header -->
    <top>
        <VBox styleClass="header" style="-fx-background-color: #4CAF50; -fx-padding: 15;">
            <Label fx:id="lblWelcome" text="DANH SÁCH SÁCH CÓ SẴN" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label text="📚 Chỉ hiển thị các sách còn có sẵn để mượn" textFill="WHITE">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center: Search và Table -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- Search box -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 5;">
                <Label text="🔍 Tìm sách:" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                <TextField fx:id="txtSearch" promptText="Nhập tên sách, tác giả hoặc nhà xuất bản"
                           prefWidth="500" style="-fx-font-size: 14;" />
                <Button text="Tìm kiếm" onAction="#handleSearch"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"
                        prefWidth="120" prefHeight="35" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="bookTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colTitle" text="Tên sách" prefWidth="250" />
                    <TableColumn fx:id="colAuthor" text="Tác giả" prefWidth="150" />
                    <TableColumn fx:id="colPublisher" text="Nhà xuất bản" prefWidth="150" />
                    <TableColumn fx:id="colYear" text="Năm" prefWidth="80" />
                    <TableColumn fx:id="colAvailableCopies" text="Tình trạng" prefWidth="150" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Info box -->
            <HBox spacing="20" style="-fx-background-color: #E8F5E9; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="ℹ️ Lưu ý:" style="-fx-font-weight: bold;" />
                <Label text="Danh sách chỉ hiển thị các sách còn có sẵn để mượn. Liên hệ thủ thư để mượn sách."
                       wrapText="true" />
            </HBox>
        </VBox>
    </center>

    <!-- Bottom: Status bar -->
    <bottom>
        <HBox style="-fx-background-color: #eeeeee; -fx-padding: 10;">
            <Label text="👤 Chế độ xem: Member (Chỉ đọc)" />
        </HBox>
    </bottom>

</BorderPane>