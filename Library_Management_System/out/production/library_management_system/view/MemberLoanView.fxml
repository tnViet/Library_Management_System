<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MemberLoanViewController" prefHeight="600.0" prefWidth="900.0">

    <!-- Header -->
    <top>
        <VBox styleClass="header" style="-fx-background-color: #FF9800; -fx-padding: 15;">
            <Label fx:id="lblWelcome" text="SÁCH ĐANG MƯỢN" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label text="📖 Danh sách các sách bạn đang mượn và hạn trả" textFill="WHITE">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center: Stats và Table -->
    <center>
        <VBox spacing="15" style="-fx-padding: 15;">

            <!-- Statistics -->
            <HBox spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 5;">
                <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <Label text="📚" style="-fx-font-size: 24;" />
                    <Label fx:id="lblTotalLoans" text="Tổng: 0 cuốn" style="-fx-font-size: 16; -fx-font-weight: bold;" />
                    <Label text="Đang mượn" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                </VBox>

                <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 1);" HBox.hgrow="ALWAYS">
                    <Label text="⚠️" style="-fx-font-size: 24;" />
                    <Label fx:id="lblOverdueLoans" text="Quá hạn: 0 cuốn" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: red;" />
                    <Label text="Cần trả gấp" style="-fx-font-size: 12; -fx-text-fill: #666;" />
                </VBox>
            </HBox>

            <!-- Table -->
            <TableView fx:id="loanTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colBookTitle" text="Tên sách" prefWidth="300" />
                    <TableColumn fx:id="colLoanDate" text="Ngày mượn" prefWidth="120" />
                    <TableColumn fx:id="colDueDate" text="Hạn trả" prefWidth="120" />
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" />
                    <TableColumn fx:id="colDaysLeft" text="Còn lại" prefWidth="120" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <!-- Warning box -->
            <HBox spacing="20" style="-fx-background-color: #FFF3E0; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="⚠️" style="-fx-font-size: 20;" />
                <VBox spacing="5">
                    <Label text="Lưu ý quan trọng:" style="-fx-font-weight: bold;" />
                    <Label text="• Trả sách đúng hạn để tránh bị phạt (5.000đ/ngày)" style="-fx-font-size: 12;" />
                    <Label text="• Liên hệ thủ thư nếu cần gia hạn thêm" style="-fx-font-size: 12;" />
                    <Label text="• Sách quá hạn sẽ không được mượn thêm sách mới" style="-fx-font-size: 12; -fx-text-fill: red; -fx-font-weight: bold;" />
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- Bottom: Status bar -->
    <bottom>
        <HBox style="-fx-background-color: #eeeeee; -fx-padding: 10;">
            <Label text="👤 Chế độ xem: Member (Chỉ đọc)" />
        </HBox>
    </bottom>

</BorderPane>