<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.BookController"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <VBox spacing="10">
            <padding><Insets top="20" right="20" bottom="10" left="20"/></padding>

            <Label text="Sách" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <!-- Search bar -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Tìm kiếm..." prefWidth="300"/>
                <Button text="🔍 Tìm" onAction="#handleSearch"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="0" right="20" bottom="20" left="20"/></padding>

            <!-- Table -->
            <TableView fx:id="bookTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="titleColumn" text="Tên Sách" prefWidth="200"/>
                    <TableColumn fx:id="authorColumn" text="Tác Giả" prefWidth="150"/>
                    <TableColumn fx:id="yearColumn" text="Năm XB" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Form -->
            <GridPane hgap="10" vgap="10">
                <padding><Insets top="10"/></padding>

                <Label text="Tên Sách:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

                <Label text="Tác Giả:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="authorField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>

                <Label text="Năm XB:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="yearField" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>

                <!-- Buttons -->
                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Button text="➕ Thêm" onAction="#handleAdd" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                    <Button text="✏️ Sửa" onAction="#handleEdit" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button text="🗑️ Xóa" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                </HBox>
            </GridPane>

        </VBox>
    </center>

</BorderPane>