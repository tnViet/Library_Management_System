<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.FineController" prefHeight="600.0" prefWidth="900.0">

    <!-- Header -->
    <top>
        <VBox styleClass="header" style="-fx-background-color: #2196F3; -fx-padding: 15;">
            <Label text="QUẢN LÝ PHẠT" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center: Form và Table -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15;">

            <!-- Form nhập liệu -->
            <VBox spacing="10" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-background-radius: 5;">
                <Label text="Thông tin phạt" style="-fx-font-size: 16; -fx-font-weight: bold;" />

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="120" />
                        <ColumnConstraints minWidth="200" prefWidth="250" />
                        <ColumnConstraints minWidth="100" prefWidth="120" />
                        <ColumnConstraints minWidth="200" prefWidth="250" />
                    </columnConstraints>

                    <!-- Row 1 -->
                    <Label text="Loan ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtLoanId" promptText="Nhập Loan ID"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Số tiền phạt:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="txtAmount" promptText="Nhập số tiền"
                               GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <!-- Row 2 -->
                    <Label text="Ngày phạt:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <DatePicker fx:id="dpFineDate" promptText="Chọn ngày"
                                GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Trạng thái:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <CheckBox fx:id="chkPaid" text="Đã thanh toán"
                              GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </GridPane>

                <!-- Buttons -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnAdd" text="Thêm" onAction="#handleAdd"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="100" />
                    <Button fx:id="btnUpdate" text="Cập nhật" onAction="#handleUpdate"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="100" />
                    <Button fx:id="btnDelete" text="Xóa" onAction="#handleDelete"
                            style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="100" />
                    <Button fx:id="btnClear" text="Làm mới" onAction="#handleClear"
                            style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-font-weight: bold;"
                            prefWidth="100" />
                </HBox>
            </VBox>

            <!-- Search box -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 10 0;">
                <Label text="Tìm theo Loan ID:" />
                <TextField fx:id="txtSearch" promptText="Nhập Loan ID để tìm" prefWidth="300" />
                <Button text="Tìm kiếm" onAction="#handleSearch"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white;" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="fineTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60" />
                    <TableColumn fx:id="colLoanId" text="Loan ID" prefWidth="100" />
                    <TableColumn fx:id="colAmount" text="Số tiền phạt" prefWidth="150" />
                    <TableColumn fx:id="colPaid" text="Trạng thái" prefWidth="200" />
                    <TableColumn fx:id="colFineDate" text="Ngày phạt" prefWidth="150" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom: Status bar (optional) -->
    <bottom>
        <HBox style="-fx-background-color: #eeeeee; -fx-padding: 10;">
            <Label text="Sẵn sàng" />
        </HBox>
    </bottom>

</BorderPane>