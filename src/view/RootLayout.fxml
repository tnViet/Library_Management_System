<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RootLayoutController">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="sidebar" prefWidth="200" style="-fx-background-color: #2c3e50;">

            <!-- Header -->
            <Label text="Thư Viện Sách" maxWidth="Infinity" alignment="CENTER"
                   style="-fx-background-color: #e67e22; -fx-text-fill: white;
                          -fx-font-weight: bold; -fx-padding: 15;">
            </Label>

            <!-- Menu Items -->
            <VBox spacing="0">
                <HBox fx:id="menuHome" styleClass="menu-item" onMouseClicked="#handleHome">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="🏠 Trang Chủ" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox fx:id="menuBook" styleClass="menu-item,menu-item-active" onMouseClicked="#handleBook">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="📚 Sách" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox fx:id="menuUser" styleClass="menu-item" onMouseClicked="#handleUser">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="👤 Độc Giả" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox fx:id="menuAuthor" styleClass="menu-item" onMouseClicked="#handleAuthor">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="✍️ Tác Giả" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="🏢 Nhà Xuất Bản" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="👥 Nhân Viên" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="📋 Phiếu Mượn" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="📥 Phiếu Nhập" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="📊 Thống Kê" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="⚙️ Chung" style="-fx-text-fill: white;"/>
                </HBox>

                <HBox styleClass="menu-item">
                    <padding><Insets top="12" right="15" bottom="12" left="15"/></padding>
                    <Label text="🚪 Đăng Xuất" style="-fx-text-fill: white;"/>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- Content area sẽ được load động -->

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

</BorderPane>
