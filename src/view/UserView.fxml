<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.UserController"
            style="-fx-background-color: #ecf0f1;">

    <top>
        <VBox spacing="10">
            <padding><Insets top="20" right="20" bottom="10" left="20"/></padding>
            <Label text="Độc Giả" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="10">
            <padding><Insets top="0" right="20" bottom="20" left="20"/></padding>

            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nameColumn" text="Họ Tên" prefWidth="200"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                </columns>
            </TableView>

            <GridPane hgap="10" vgap="10">
                <padding><Insets top="10"/></padding>

                <Label text="Họ Tên:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="300"/>

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="300"/>

                <Label text="SĐT:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="300"/>

                <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Button text="➕ Thêm" onAction="#handleAdd" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
                    <Button text="✏️ Sửa" onAction="#handleEdit" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button text="🗑️ Xóa" onAction="#handleDelete" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                </HBox>
            </GridPane>

        </VBox>
    </center>

</BorderPane>